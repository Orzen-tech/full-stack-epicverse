diff -ruN a/backend/app/services/email_verification.py b/backend/app/services/email_verification.py
--- a/backend/app/services/email_verification.py	1970-01-01 05:30:00.000000000 +0530
+++ b/backend/app/services/email_verification.py	2026-10-17 14:49:26.656538000 +0530
@@ -0,0 +1,314 @@
+"""Server-side email-ownership verification.
+
+Why this exists: `email_verified` used to be settable by ANY signed-in user through POST /auth/mark-verified, so the
+"verify your email" step during registration was enforced only by the app. Now the flag can only be set by one of two
+server-checked proofs of mailbox control:
+
+  * signup (the account does not exist yet)  - /auth/verify-otp issues a random, single-use, 30-minute PROOF. The
+    caller presents it to the authenticated /auth/mark-verified, which takes the UID and the email ONLY from the
+    verified Firebase token. Only the device that received the proof can use it.
+  * an existing signed-in user               - /auth/email/verify-request sends a code to the email stored on the
+    user's row; /auth/email/verify-confirm checks it. The challenge is bound to the UID and that email.
+
+Nothing here is logged with an identifier, proof, OTP or email. The proof and the email are stored only as keyed hashes
+(HMAC-SHA256 with MFA_OTP_HASH_SECRET and distinct domain-separation labels). Every multi-statement operation runs in ONE
+transaction, with every check BEFORE the first write; a failure after a write raises so the whole transaction rolls back
+(a plain `return` inside `async with conn.transaction()` would COMMIT, so no function below returns after a write
+unless the write set is complete).
+"""
+import hashlib
+import hmac
+import secrets
+from datetime import datetime, timedelta, timezone
+
+from app.core.config import settings
+from app.core.log_privacy import safe_exc
+from app.services.db_pool import get_pool
+from app.services.otp_rate_limiter import _hmac_hash, _incr_scope, _window_start
+
+PROOF_PREFIX = "evp1_"                      # the app ignores a proof without this prefix
+PROOF_LIFETIME = timedelta(minutes=30)
+PROOF_MAX_LEN = 128
+OTP_VALID_MINUTES_SIGNUP = 1                # unchanged: the emailed signup code stays valid for one minute
+MAX_OTP_ATTEMPTS = 5                        # unchanged signup-code attempt limit
+CHALLENGE_LIFETIME = timedelta(minutes=5)
+CHALLENGE_MAX_ATTEMPTS = 5
+UID_ATTEMPT_LIMIT = 10                      # failed or successful mark-verified / confirm calls per UID per 10 minutes
+
+RESULT_OK = "ok"
+RESULT_INVALID = "invalid"                  # any reason; callers must not reveal which check failed
+RESULT_WRONG_OTP = "wrong_otp"
+RESULT_TOO_MANY = "too_many_attempts"
+RESULT_ERROR = "error"                      # database / configuration trouble -> 503, never "invalid"
+
+
+class _Rollback(Exception):
+    """Raised inside a transaction to roll everything back."""
+
+
+def norm_email(value) -> str:
+    return value.strip().lower() if isinstance(value, str) else ""
+
+
+def secret_available() -> bool:
+    return bool(settings.MFA_OTP_HASH_SECRET)
+
+
+def _hmac_hex(label: str, value: str) -> str:
+    return hmac.new(settings.MFA_OTP_HASH_SECRET.encode("utf-8"), f"{label}:{value}".encode("utf-8"),
+                    hashlib.sha256).hexdigest()
+
+
+def _proof_hash(raw: str) -> str:
+    return _hmac_hex("email-proof", raw)
+
+
+def _email_hash(email: str) -> str:
+    return _hmac_hex("email-proof-email", email)
+
+
+def _challenge_email_hash(email: str) -> str:
+    return _hmac_hex("email-verify-email", email)
+
+
+def _challenge_otp_hash(challenge_id: str, otp: str) -> str:
+    return _hmac_hex("email-verify-otp", f"{challenge_id}:{otp}")
+
+
+async def ensure_schema(conn) -> None:
+    """Additive only: two new tables. No existing table or constraint is touched."""
+    await conn.execute('''
+        CREATE TABLE IF NOT EXISTS email_verification_proofs (
+            proof_hash TEXT PRIMARY KEY,
+            email_hash TEXT NOT NULL,
+            created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+            expires_at TIMESTAMPTZ NOT NULL,
+            consumed_at TIMESTAMPTZ NULL,
+            consumed_by_uid TEXT NULL
+        )
+    ''')
+    await conn.execute(
+        "CREATE INDEX IF NOT EXISTS idx_email_proofs_email ON email_verification_proofs (email_hash)")
+    await conn.execute(
+        "CREATE INDEX IF NOT EXISTS idx_email_proofs_expires ON email_verification_proofs (expires_at)")
+    await conn.execute('''
+        CREATE TABLE IF NOT EXISTS email_verification_challenges (
+            challenge_id TEXT PRIMARY KEY,
+            uid TEXT NOT NULL REFERENCES users(uid) ON DELETE CASCADE,
+            email_hash TEXT NOT NULL,
+            otp_hash TEXT NOT NULL,
+            attempts INT NOT NULL DEFAULT 0 CHECK (attempts >= 0),
+            created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+            expires_at TIMESTAMPTZ NOT NULL,
+            consumed_at TIMESTAMPTZ NULL
+        )
+    ''')
+    await conn.execute(
+        "CREATE INDEX IF NOT EXISTS idx_email_challenges_uid ON email_verification_challenges (uid)")
+
+
+# --------------------------------------------------------------------------------------------------------------------
+# Signup proof
+# --------------------------------------------------------------------------------------------------------------------
+
+async def verify_otp_and_issue_proof(identifier: str, otp: str) -> tuple[str, str | None]:
+    """Checks the emailed code and, for an email identifier, issues the proof IN THE SAME TRANSACTION.
+
+    Returns (result, raw_proof). result is 'success' | 'invalid' | 'too_many_attempts' | 'error'.
+    The code is consumed only if the proof is stored: any exception rolls the code deletion back, so a failure never burns
+    the user's code. Wrong attempts are counted and committed exactly as before (same limits and same one-minute validity)."""
+    ident = (identifier or "").lower()               # exactly the key save_otp() stores (it only lower-cases)
+    email = norm_email(identifier)
+    wants_proof = "@" in email
+    if wants_proof and not secret_available():
+        return "error", None                          # fail closed BEFORE the code is touched
+    raw_proof = (PROOF_PREFIX + secrets.token_urlsafe(32)) if wants_proof else None
+    try:
+        pool = await get_pool()
+        async with pool.acquire() as conn:
+            async with conn.transaction():
+                row = await conn.fetchrow('''
+                    SELECT otp, attempts FROM user_otps
+                    WHERE identifier = $1 AND created_at > (NOW() - INTERVAL '1 minute')
+                    FOR UPDATE
+                ''', ident)
+                if not row:
+                    return "invalid", None
+                if row["attempts"] >= MAX_OTP_ATTEMPTS:
+                    await conn.execute("DELETE FROM user_otps WHERE identifier = $1", ident)
+                    return "too_many_attempts", None
+                if not hmac.compare_digest((row["otp"] or "").encode("utf-8"), (otp or "").encode("utf-8")):
+                    attempts = row["attempts"] + 1
+                    if attempts >= MAX_OTP_ATTEMPTS:
+                        await conn.execute("DELETE FROM user_otps WHERE identifier = $1", ident)
+                        return "too_many_attempts", None
+                    await conn.execute("UPDATE user_otps SET attempts = $2 WHERE identifier = $1", ident, attempts)
+                    return "invalid", None
+                # Correct code. From here on every statement is a write and any failure must roll back all of them.
+                await conn.execute("DELETE FROM user_otps WHERE identifier = $1", ident)
+                if wants_proof:
+                    eh = _email_hash(email)
+                    await conn.execute("SELECT pg_advisory_xact_lock(hashtext($1))", eh)
+                    await conn.execute(
+                        "DELETE FROM email_verification_proofs WHERE expires_at < NOW() - INTERVAL '1 day'")
+                    # One active proof per email: an earlier unused one is superseded.
+                    await conn.execute(
+                        "UPDATE email_verification_proofs SET consumed_at = NOW() "
+                        "WHERE email_hash = $1 AND consumed_at IS NULL", eh)
+                    await conn.execute('''
+                        INSERT INTO email_verification_proofs (proof_hash, email_hash, created_at, expires_at)
+                        VALUES ($1, $2, NOW(), NOW() + $3::interval)
+                    ''', _proof_hash(raw_proof), eh, PROOF_LIFETIME)
+                return "success", raw_proof
+    except Exception as e:
+        print(f"[EMAIL-VERIFY] otp/proof transaction failed: {safe_exc(e)}", flush=True)
+        return "error", None
+
+
+async def _uid_attempt_allowed(conn, uid: str) -> bool:
+    """Per-UID cap on proof/confirm attempts, in the existing rate-limit table (the limiter module is not modified)."""
+    now = datetime.now(timezone.utc)
+    count = await _incr_scope(conn, _hmac_hash(settings.MFA_OTP_HASH_SECRET, f"email-verify-uid:{uid}"),
+                              "email_verify_uid", _window_start(now))
+    return count <= UID_ATTEMPT_LIMIT
+
+
+async def consume_proof(uid: str, token_email: str, raw_proof: str | None) -> str:
+    """Marks ONLY this UID verified, using a proof issued for this exact email. `uid` and `token_email` must come from a
+    verified Firebase ID token. Returns RESULT_OK | RESULT_INVALID | RESULT_TOO_MANY | RESULT_ERROR.
+
+    Order inside the transaction: lock the user row, check everything (no writes), then consume the proof and set the flag.
+    A user who is already verified returns OK without touching anything, so a retry after a lost response is harmless."""
+    email = norm_email(token_email)
+    if not secret_available():
+        return RESULT_ERROR
+    if not uid or "@" not in email:
+        return RESULT_INVALID
+    try:
+        pool = await get_pool()
+        async with pool.acquire() as conn:
+            async with conn.transaction():
+                if not await _uid_attempt_allowed(conn, uid):
+                    return RESULT_TOO_MANY                      # the counter is committed: attempts cannot be undone
+                user = await conn.fetchrow("SELECT email, email_verified FROM users WHERE uid = $1 FOR UPDATE", uid)
+                if user is None:
+                    return RESULT_INVALID
+                if user["email_verified"]:
+                    return RESULT_OK
+                if norm_email(user["email"]) != email:
+                    return RESULT_INVALID
+                if (not isinstance(raw_proof, str) or not raw_proof.startswith(PROOF_PREFIX)
+                        or len(raw_proof) > PROOF_MAX_LEN):
+                    return RESULT_INVALID
+                proof = await conn.fetchrow('''
+                    SELECT email_hash FROM email_verification_proofs
+                    WHERE proof_hash = $1 AND consumed_at IS NULL AND expires_at > NOW()
+                    FOR UPDATE
+                ''', _proof_hash(raw_proof))
+                if proof is None or not hmac.compare_digest(proof["email_hash"], _email_hash(email)):
+                    return RESULT_INVALID
+                # ---- writes: both or neither ----
+                await conn.execute(
+                    "UPDATE email_verification_proofs SET consumed_at = NOW(), consumed_by_uid = $2 WHERE proof_hash = $1",
+                    _proof_hash(raw_proof), uid)
+                status = await conn.execute(
+                    "UPDATE users SET email_verified = TRUE WHERE uid = $1 AND LOWER(email) = $2", uid, email)
+                if int(status.split()[-1]) != 1:
+                    raise _Rollback()
+                return RESULT_OK
+    except _Rollback:
+        return RESULT_INVALID
+    except Exception as e:
+        print(f"[EMAIL-VERIFY] proof consume failed: {safe_exc(e)}", flush=True)
+        return RESULT_ERROR
+
+
+# --------------------------------------------------------------------------------------------------------------------
+# Existing signed-in user
+# --------------------------------------------------------------------------------------------------------------------
+
+async def create_challenge(uid: str, email: str) -> tuple[str, str] | None:
+    """Creates a code for this UID and email (any earlier open one for the UID is superseded). Returns (challenge_id, otp),
+    or None when the secret is missing or the database fails (the caller answers 503; nothing is sent)."""
+    email = norm_email(email)
+    if not secret_available() or not uid or "@" not in email:
+        return None
+    otp = str(secrets.randbelow(900000) + 100000)
+    challenge_id = secrets.token_urlsafe(32)
+    try:
+        pool = await get_pool()
+        async with pool.acquire() as conn:
+            async with conn.transaction():
+                await conn.execute(
+                    "DELETE FROM email_verification_challenges WHERE uid = $1 AND expires_at < NOW() - INTERVAL '1 hour'", uid)
+                await conn.execute(
+                    "UPDATE email_verification_challenges SET consumed_at = NOW() WHERE uid = $1 AND consumed_at IS NULL", uid)
+                await conn.execute('''
+                    INSERT INTO email_verification_challenges (challenge_id, uid, email_hash, otp_hash, attempts, created_at, expires_at)
+                    VALUES ($1, $2, $3, $4, 0, NOW(), NOW() + $5::interval)
+                ''', challenge_id, uid, _challenge_email_hash(email), _challenge_otp_hash(challenge_id, otp), CHALLENGE_LIFETIME)
+        return challenge_id, otp
+    except Exception as e:
+        print(f"[EMAIL-VERIFY] challenge create failed: {safe_exc(e)}", flush=True)
+        return None
+
+
+async def invalidate_challenge(challenge_id: str, uid: str) -> None:
+    try:
+        pool = await get_pool()
+        async with pool.acquire() as conn:
+            await conn.execute(
+                "UPDATE email_verification_challenges SET consumed_at = NOW() WHERE challenge_id = $1 AND uid = $2 AND consumed_at IS NULL",
+                challenge_id, uid)
+    except Exception as e:
+        print(f"[EMAIL-VERIFY] challenge invalidate failed: {safe_exc(e)}", flush=True)
+
+
+async def confirm_challenge(uid: str, challenge_id: str, otp: str, token_email: str) -> str:
+    """Verifies ONE user's email: only the authenticated UID, only if its row holds the token's email, and only with a
+    correct, unexpired, unconsumed challenge created for that same UID and email. The challenge is consumed and the flag set
+    in one transaction. Wrong attempts are recorded and committed (never rolled back)."""
+    email = norm_email(token_email)
+    if not secret_available():
+        return RESULT_ERROR
+    if not uid or "@" not in email or not isinstance(challenge_id, str) or len(challenge_id) > 128:
+        return RESULT_INVALID
+    try:
+        pool = await get_pool()
+        async with pool.acquire() as conn:
+            async with conn.transaction():
+                if not await _uid_attempt_allowed(conn, uid):
+                    return RESULT_TOO_MANY
+                user = await conn.fetchrow("SELECT email, email_verified FROM users WHERE uid = $1 FOR UPDATE", uid)
+                if user is None or norm_email(user["email"]) != email:
+                    return RESULT_INVALID
+                ch = await conn.fetchrow('''
+                    SELECT uid, email_hash, otp_hash, attempts, consumed_at, (expires_at <= NOW()) AS expired
+                    FROM email_verification_challenges WHERE challenge_id = $1 FOR UPDATE
+                ''', challenge_id)
+                if (ch is None or ch["uid"] != uid or ch["consumed_at"] is not None or ch["expired"]
+                        or not hmac.compare_digest(ch["email_hash"], _challenge_email_hash(email))):
+                    return RESULT_INVALID
+                if ch["attempts"] >= CHALLENGE_MAX_ATTEMPTS:
+                    return RESULT_TOO_MANY
+                if not hmac.compare_digest(_challenge_otp_hash(challenge_id, otp), ch["otp_hash"]):
+                    attempts = ch["attempts"] + 1
+                    locked = attempts >= CHALLENGE_MAX_ATTEMPTS
+                    await conn.execute(
