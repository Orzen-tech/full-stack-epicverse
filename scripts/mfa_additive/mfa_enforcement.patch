@@ -176,6 +176,30 @@
     return row is not None
 
 
+async def get_mfa_session_ttl_seconds(raw_token: str | None, uid: str,
+                                      auth_time: datetime | None) -> float | None:
+    """Seconds of validity left for this session, measured with PostgreSQL's own clock.
+
+    The WHERE clause is deliberately IDENTICAL to validate_mfa_session(), so this can never
+    report a session that the validator rejects. Returns None when the session is not valid.
+    Database errors propagate (callers fail closed). Used by the WebSocket to schedule the
+    close at expiry without needing the database again.
+    """
+    if not raw_token or not uid or auth_time is None:
+        return None
+    pool = await get_pool()
+    async with pool.acquire() as conn:
+        row = await conn.fetchrow('''
+            SELECT EXTRACT(EPOCH FROM (expires_at - NOW())) AS ttl_seconds FROM mfa_sessions
+            WHERE session_hash = $1 AND uid = $2 AND auth_time = $3
+              AND expires_at > NOW() AND revoked_at IS NULL
+        ''', _session_hash(raw_token), uid, auth_time)
+    if row is None:
+        return None
+    ttl = float(row["ttl_seconds"])
+    return ttl if ttl > 0 else None
+
