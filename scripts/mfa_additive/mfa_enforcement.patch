+                try:
+                    from app.api.dependencies import MFA_SESSION_REQUIRED_DETAIL as _d
+                    frame = {"type": "error", "code": _d["code"], "message": _d["message"]}
+                except Exception:
+                    frame = {"type": "error", "code": "MFA_SESSION_REQUIRED"}
+                await asyncio.wait_for(self.client_ws.send_text(json.dumps(frame)), timeout=5.0)
+            except Exception:
+                pass
+        try:
+            if code == 1013:
+                await asyncio.wait_for(self.client_ws.close(code=1013, reason="mfa-check-unavailable"), timeout=5.0)
+            else:
+                await asyncio.wait_for(self.client_ws.close(code=code), timeout=5.0)
+        except Exception:
+            pass
+        self._mfa_count(event)
+
+    async def _mfa_tick(self) -> bool:
+        """One MFA revalidation. Returns True when it closed the connection. Never raises.
+
+        An unexpected exception can NOT silently disable enforcement: for an enforced MFA session
+        the known expiry and the fail-closed deadline are still applied (see
+        _mfa_fail_closed_after_error). Non-enforced sessions ignore the failure, as before."""
+        try:
+            closed = await self._mfa_tick_inner()
+            self._mfa_err_streak = 0
+            return closed
+        except Exception:
+            try:
+                return await self._mfa_fail_closed_after_error()
+            except Exception:
+                return False
+
+    async def _mfa_fail_closed_after_error(self) -> bool:
+        self._mfa_err_streak += 1
+        if not (self._mfa_enforce and self._mfa_required):
+            return False
+        now = time.monotonic()
+        if self._mfa_expiry_mono is not None and now >= self._mfa_expiry_mono:
+            await self._mfa_close(1008, True, "ws_closed_expired")
+            return True
+        if now - self._mfa_last_ok_mono >= settings.MFA_WS_FAILCLOSED_SECONDS:
+            await self._mfa_close(1013, False, "ws_closed_db_unavailable")
+            return True
+        return False
+
+    async def _mfa_tick_inner(self) -> bool:
+        """One revalidation pass (may raise; _mfa_tick turns an unexpected exception into the fail-closed handling)."""
+        from app.api.dependencies import evaluate_mfa
+        now = time.monotonic()
+
+        # 1. Expiry. The remaining TTL was measured by PostgreSQL at the handshake and is
+        #    tracked on the monotonic clock, so this needs no database.
+        if self._mfa_enforce and self._mfa_required and \
+                self._mfa_expiry_mono is not None and now >= self._mfa_expiry_mono:
+            # One look at the account first: if MFA was switched off since the last check,
+            # there is nothing to expire. A database error (or MFA still on) closes, so
+            # expiry is honoured even while PostgreSQL is unreachable.
+            recheck = await evaluate_mfa(self.uid, self._mfa_auth_time, None)
+            if recheck.outcome in ("not_enabled", "no_row"):
+                self._mfa_last_ok_mono = now
+                self._mfa_required = False
+                self._mfa_expiry_mono = None
+                return False
+            await self._mfa_close(1008, True, "ws_closed_expired")
+            return True
+
+        # 2. Revalidate against PostgreSQL (account flag, then the unchanged validator).
+        decision = await evaluate_mfa(self.uid, self._mfa_auth_time, self._mfa_session)
+
+        if decision.outcome != "db_error":
+            self._mfa_db_err_counted = False
+
+        if decision.outcome == "valid":
+            self._mfa_last_ok_mono = now
+            self._mfa_required = True
+            return False
+        if decision.outcome == "not_enabled":
+            # MFA is (or has been switched) off: nothing to enforce any more.
+            self._mfa_last_ok_mono = now
+            self._mfa_required = False
+            self._mfa_expiry_mono = None
+            return False
+        if decision.outcome == "no_row":
+            self._mfa_last_ok_mono = now
+            self._mfa_count("no_row endpoint=websocket_watchdog")
+            return False
+        if decision.outcome == "invalid":
+            # Revoked, expired, or MFA enabled on another device while this connection
+            # holds no valid MFA session.
+            if self._mfa_enforce:
+                await self._mfa_close(1008, True, "ws_closed_revoked")
+                return True
+            if not self._mfa_would_close_counted:
+                self._mfa_would_close_counted = True
+                self._mfa_count("would_close endpoint=websocket_watchdog")
+            return False
+
+        # db_error: only an ENFORCED connection that is known to need MFA is closed, and
+        # only after MFA_WS_FAILCLOSED_SECONDS without a successful check. Every other
+        # session ignores database errors here, exactly as before.
+        if self._mfa_enforce and self._mfa_required and \
+                now - self._mfa_last_ok_mono >= settings.MFA_WS_FAILCLOSED_SECONDS:
+            await self._mfa_close(1013, False, "ws_closed_db_unavailable")
+            return True
+        if not self._mfa_db_err_counted:
+            self._mfa_db_err_counted = True
+            self._mfa_count("db_error_allowed endpoint=websocket_watchdog")
+        return False
 
     # ─────────────────────────────────────────────────────────────────────────
     # Session lifecycle
