+async def get_mfa_state(uid: str) -> dict | None:
+    """F-09 Phase 1 enforcement: the server-side MFA flag for this UID, read from PostgreSQL.
+
+    Returns {"mfa_enabled": bool}, or None when the account has no row. Unlike the
+    session helpers above, this function deliberately does NOT catch database errors:
+    callers must be able to tell "database unavailable" apart from "no row" and fail closed.
+    """
+    pool = await get_pool()
+    async with pool.acquire() as conn:
+        row = await conn.fetchrow("SELECT mfa_enabled FROM users WHERE uid = $1", uid)
+    if row is None:
+        return None
+    return {"mfa_enabled": bool(row["mfa_enabled"])}
+
