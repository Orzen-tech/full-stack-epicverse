diff -ruN nb/backend/app/core/log_privacy.py nw/backend/app/core/log_privacy.py
--- nb/backend/app/core/log_privacy.py	1970-01-01 05:30:00.000000000 +0530
+++ nw/backend/app/core/log_privacy.py	2026-10-16 12:15:38.679236200 +0530
@@ -0,0 +1,283 @@
+"""Keeps personal data and credentials out of the application's own logs (stdout/stderr, which Cloud Run ships to Cloud Logging).
+
+What this module provides
+  * mask_id()            - a non-reversible correlation id (keyed HMAC) for UIDs and session ids, so one user's log lines can be
+                           followed without the raw identifier ever being written;
+  * safe_exc() / safe_traceback() - exception class (plus SQLSTATE / HTTP status when present) instead of the exception TEXT, which
+                           can echo submitted tokens, e-mail addresses, SQL parameters or connection details;
+  * QuerySanitizerFilter - rewrites the request lines uvicorn writes itself: every query-string VALUE becomes ``***`` and long
+                           user-id path segments (``/api/v1/user/<uid>``) and invite codes become correlation ids / ``***``.
+                           The query sanitising logic is the reviewed logic of commit cc305d4 (log_sanitizer.py), extended with
+                           the path-segment masking.
+  * the same filter also replaces any traceback uvicorn/Starlette/asyncio log for an unhandled exception (exception TEXT and
+                           source lines) with the exception class and call-site frames; the exception itself still propagates unchanged;
+  * safe_code()          - provider error code/type (short token) instead of provider message text.
+
+What this module does NOT cover
+  * Cloud Run's own request log (``run.googleapis.com/requests``) records the full request URL as received, UID path segments and
+    WebSocket query parameters included. No application log filter can change that.
+  * Responses sent to clients (a few error handlers still return ``str(e)`` to the caller): not a log, left unchanged.
+"""
+import functools
+import hashlib
+import hmac
+import logging
+import re
+import traceback
+
+from app.core.config import settings
+
+REDACTED = "***"
+LOGGER_NAMES = ("uvicorn", "uvicorn.access", "uvicorn.error", "asyncio", "starlette", "fastapi")
+
+_MAX_INPUT = 8192          # characters examined per string; the rest is dropped
+_MAX_ITEMS = 20            # query items kept per target
+_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_.\-]{0,31}")
+# A request target inside a log string: "/path?query", also within "https://host/path?query".
+_TARGET = re.compile(r"/[^\s\"'?#]*\?[^\s\"'#]*")
+# A user id (Firebase UIDs are 28 characters) in the path; short literal route words such as "mfa" are left alone.
+_USER_PATH = re.compile(r"(/api/v1/user/)([^/\s\"'?#]{12,})")
+_INVITE_PATH = re.compile(r"(/api/v1/validate-invite/)([^/\s\"'?#]+)")
+
+
+@functools.lru_cache(maxsize=1)
+def _key() -> bytes:
+    secret = (getattr(settings, "OTP_RATE_LIMIT_HASH_SECRET", "") or getattr(settings, "MFA_OTP_HASH_SECRET", "") or "")
+    return hmac.new(secret.encode("utf-8"), b"epicverse-log-correlation-v1", hashlib.sha256).digest()
+
+
+@functools.lru_cache(maxsize=4096)
+def mask_id(value, kind: str = "id") -> str:
+    """Correlation id such as ``u-1a2b3c4d5e``: the same input always gives the same id, the input cannot be recovered from it."""
+    if value is None:
+        return "none"
+    text = str(value)
+    if text == "":
+        return "empty"
+    if text == "anonymous":
+        return text
+    digest = hmac.new(_key(), (kind + ":" + text).encode("utf-8"), hashlib.sha256).hexdigest()[:10]
+    return f"{kind}-{digest}"
+
+
+def safe_exc(exc: BaseException) -> str:
+    """The exception class and, when present, its SQLSTATE or HTTP status code. Never the exception text."""
+    try:
+        name = type(exc).__name__
+        code = getattr(exc, "sqlstate", None)
+        if code is None:
+            code = getattr(exc, "status_code", None)
+        if code is None:
+            response = getattr(exc, "response", None)
+            code = getattr(response, "status_code", None)
+        return f"{name}[{code}]" if code is not None else name
+    except Exception:
+        return "Exception"
+
+
+_CODE = re.compile(r"[A-Za-z0-9_.\-]{1,64}")
+
+
+def safe_code(value) -> str:
+    """A provider error code/type such as ``invalid_request_error`` when it looks like one; ``?`` otherwise (never free text)."""
+    text = str(value) if value is not None else ""
+    return text if _CODE.fullmatch(text) else "?"
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Log-safe views of provider ids and model-generated values (8K). Logging only: callers keep using the original values.
+# Strict allow-lists (not "looks like a token" checks): a value that is not on the list is reported as "other", so
+# user-supplied or model-generated free text can never reach a log line through these helpers.
+# ---------------------------------------------------------------------------------------------------------------------
+_KNOWN_TOOLS = ("query_database_for_combo", "stay_silent", "get_combo_reason")
+_KNOWN_MODES = ("OriginArc (Balakanda)", "CrownShift (AyodhyaKanda)", "WildRun (AranyaKanda)",
+                "GlowLine (KishkindhaKanda)", "lankaLeap (SundaraKanda)", "WarRoom (YuddhaKanda)",
+                "AfterLight (UttaraKanda)", "N/A (No tool call)")
+_KNOWN_LANGUAGES = (
+    "English", "French", "Spanish", "German", "Portuguese", "Italian", "Dutch", "Swedish", "Danish", "Norwegian",
+    "Finnish", "Polish", "Czech", "Slovak", "Romanian", "Hungarian", "Turkish", "Indonesian", "Malay", "Vietnamese",
+    "Swahili", "Afrikaans", "Catalan", "Croatian", "Slovenian", "Estonian", "Latvian", "Lithuanian", "Filipino",
+    "Tagalog", "Tamil", "Malayalam", "Telugu", "Kannada", "Bengali", "Gujarati", "Odia", "Punjabi", "Thai",
+    "Georgian", "Greek", "Hebrew", "Korean", "Chinese", "Japanese", "Hindi", "Marathi", "Urdu", "Arabic", "Persian",
+    "Russian", "Ukrainian", "Bulgarian", "Serbian", "Nepali", "Sanskrit", "Pashto", "Konkani",
+    "Devanagari", "ArabicScript", "Cyrillic", "Latin",
+)
+_MODE_NUMBER = re.compile(r"Mode [0-9]{1,2}")
+
+
+def _lookup(table):
+    return {name.lower(): name for name in table}
+
+
+_TOOL_BY_KEY = _lookup(_KNOWN_TOOLS)
+_MODE_BY_KEY = _lookup(_KNOWN_MODES)
+_LANGUAGE_BY_KEY = _lookup(_KNOWN_LANGUAGES)
+
+
+def _allowed(value, table) -> str:
+    """The canonical spelling when ``value`` is on the allow-list, ``none`` when absent, otherwise ``other``."""
+    try:
+        if value is None:
+            return "none"
+        if not isinstance(value, str):
+            return "other"
+        return table.get(value.strip().lower(), "other")
+    except Exception:
+        return "other"
+
+
+def safe_tool(value) -> str:
+    """Tool/function name from the allow-list of tools this backend defines, else ``other``."""
+    return _allowed(value, _TOOL_BY_KEY)
+
+
+def safe_mode(value) -> str:
+    """Game mode: one of the seven known mode names, ``Mode <n>``, or ``other`` (never the original text)."""
+    try:
+        if isinstance(value, str) and _MODE_NUMBER.fullmatch(value.strip()):
+            return value.strip()
+    except Exception:
+        return "other"
+    return _allowed(value, _MODE_BY_KEY)
+
+
+def safe_language(value) -> str:
+    """Language or script-family name from a fixed list, else ``other``."""
+    return _allowed(value, _LANGUAGE_BY_KEY)
+
+
+def safe_len(value) -> int:
+    """Length of a string/bytes value, without its content; -1 for anything else."""
+    try:
+        return len(value) if isinstance(value, (str, bytes)) else -1
+    except Exception:
+        return -1
+
+
+def arg_kind(value) -> str:
+    """``digits``, ``empty``, ``text`` or ``invalid``: what kind of value it is, not what it says."""
+    try:
+        if not isinstance(value, str):
+            return "invalid"
+        stripped = value.strip()
+        if not stripped:
+            return "empty"
+        return "digits" if (stripped.isascii() and stripped.isdigit()) else "text"
+    except Exception:
+        return "invalid"
+
+
+def mask_provider(value) -> str:
+    """Correlation id for an id issued by the AI provider (session, response, item, call): ``o-<10 hex>``.
+
+    Same input -> same output, so lines can still be followed; nothing of the original is shown. Absent or malformed
+    values give ``none`` / ``invalid`` and never raise."""
+    try:
+        if value is None or value in ("", "?"):
+            return "none"
+        if not isinstance(value, str):
+            return "invalid"
+        return mask_id(value, "o")
+    except Exception:
+        return "invalid"
+
+
+
+def safe_traceback(exc: BaseException, limit: int = 12) -> str:
+    """Call-site frames (file, line, function) and the exception class: no exception text, no source lines, no local values."""
+    try:
+        frames = traceback.extract_tb(exc.__traceback__)[-limit:]
+        where = " <- ".join(f"{f.filename.rsplit('/', 1)[-1]}:{f.lineno}:{f.name}" for f in reversed(frames))
+        return f"[TRACE] {safe_exc(exc)} at {where}" if where else f"[TRACE] {safe_exc(exc)}"
+    except Exception:
+        return "[TRACE] unavailable"
+
+
+# ---------------------------------------------------------------------------------------------------------------------
+# uvicorn request lines
+# ---------------------------------------------------------------------------------------------------------------------
+def sanitize_target(target: str) -> str:
+    """Return ``target`` ("/path?query") with every query value redacted."""
+    path, _, rest = target.partition("?")
+    query = rest.partition("#")[0]          # fragments are never sent; drop defensively
+    items = []
+    for raw in query.split("&"):
+        if raw == "":
+            continue
+        if len(items) >= _MAX_ITEMS:
+            items.append("...")
+            break
+        name, sep, _value = raw.partition("=")
+        items.append(f"{name}={REDACTED}" if sep and _NAME.fullmatch(name) else REDACTED)
+    return path + ("?" + "&".join(items) if items else "")
+
+
+def _mask_path_ids(text: str) -> str:
+    text = _USER_PATH.sub(lambda m: m.group(1) + mask_id(m.group(2), "u"), text)
+    return _INVITE_PATH.sub(lambda m: m.group(1) + REDACTED, text)
+
+
+def sanitize_text(text: str) -> str:
+    """Redact the query string of every request target found inside ``text`` and mask user ids / invite codes in the path."""
+    clipped = text[:_MAX_INPUT] + ("..." if len(text) > _MAX_INPUT else "")
+    try:
+        return _TARGET.sub(lambda m: sanitize_target(m.group(0)), _mask_path_ids(clipped))
+    except Exception:                        # fail closed: drop everything after each '?'
+        return re.sub(r"\?[^\s\"']*", "", clipped)
+
+
+def _needs_work(value) -> bool:
+    return isinstance(value, str) and ("?" in value or "/api/v1/" in value)
+
+
+class QuerySanitizerFilter(logging.Filter):
+    """Rewrites request targets in the message and in string arguments, in place."""
+
+    def filter(self, record: logging.LogRecord) -> bool:
+        try:
+            if _needs_work(record.msg):
+                record.msg = sanitize_text(record.msg)
+            args = record.args
+            if isinstance(args, tuple) and any(_needs_work(a) for a in args):
+                # Same length, same positions: uvicorn's AccessFormatter unpacks five values.
+                record.args = tuple(sanitize_text(a) if _needs_work(a) else a for a in args)
+            elif isinstance(args, dict):
+                record.args = {k: sanitize_text(v) if _needs_work(v) else v for k, v in args.items()}
+        except Exception:
+            # Never let logging break a request, and never leave an unsanitised target behind.
+            record.msg = "[log record withheld: could not be sanitised]"
+            record.args = ()
+        self._scrub_exception(record)
+        return True
+
+    @staticmethod
+    def _scrub_exception(record: logging.LogRecord) -> None:
+        """Replaces the formatted traceback (exception TEXT, source lines) with exception class + call-site frames.
+
+        logging.Formatter appends ``record.exc_text`` when ``exc_info`` is empty, so setting it here, and clearing exc_info,
+        keeps the diagnostic without the text. The exception itself still propagates exactly as before; only the log differs.
+        """
+        try:
+            exc = record.exc_info[1] if isinstance(record.exc_info, tuple) and len(record.exc_info) > 1 else None
+            if exc is not None:
+                record.exc_text = safe_traceback(exc)
+                record.exc_info = None
+            elif record.exc_text:
+                record.exc_text = "[TRACE] traceback withheld"
+        except Exception:
+            record.exc_info = None
+            record.exc_text = "[TRACE] unavailable"
+
+
+def install() -> list:
+    """Attach the filter to uvicorn's loggers. Safe to call more than once.
+
+    Returns the names of the loggers it attached to on this call.
+    """
+    attached = []
+    for name in LOGGER_NAMES:
+        logger = logging.getLogger(name)
+        if not any(isinstance(f, QuerySanitizerFilter) for f in logger.filters):
+            logger.addFilter(QuerySanitizerFilter())
+            attached.append(name)
+    return attached
